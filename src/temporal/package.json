{
  "name": "@agent-local/temporal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Temporal workflow integration: an alternative workflow engine behind the same mount(app, ctx) seam as @agent-local/workflow. Code-first (no BPMN deploy); the agent reports results via a signal and the Workflow decides done/next.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --enable-source-maps dist/main.js",
    "test": "jest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agent-local/common": "0.1.0",
    "@temporalio/workflow": "^1.18.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@temporalio/testing": "^1.18.1",
    "@temporalio/worker": "^1.18.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
