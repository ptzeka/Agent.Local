{
  "name": "@agent-local/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local coding agent runtime and CLI. Orchestrates LLM providers and MCP tool servers.",
  "bin": {
    "agent-local": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "start:server": "node dist/server/index.js",
    "dev:server": "tsx src/server/index.ts",
    "db:init": "node dist/db-init.js",
    "db:init:dev": "tsx src/db-init.ts",
    "test": "jest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agent-local/common": "*",
    "@agent-local/mcp": "*",
    "@anthropic-ai/sdk": "^0.102.0",
    "express": "^4.21.2",
    "@google/genai": "^2.8.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "ollama": "^0.5.11",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
