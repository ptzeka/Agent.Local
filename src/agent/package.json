{
  "name": "@agent-local/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local coding agent runtime and CLI. Orchestrates LLM providers and MCP tool servers.",
  "bin": {
    "agent-local": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "ollama": "^0.5.11",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
