{
  "name": "@rxo/codeindex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repository vectorizer — chunks, embeds, and publishes the working tree to PostgreSQL/pgvector for consumption by the codemcp server.",
  "bin": {
    "codeindex": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "jest",
    "start": "node dist/cli.js",
    "plan": "node dist/cli.js plan",
    "plan:file": "node dist/cli.js --backend file plan",
    "plan:pg": "node dist/cli.js --backend pg plan",
    "migrate": "node dist/cli.js migrate",
    "migrate:file": "node dist/cli.js --backend file migrate",
    "migrate:pg": "node dist/cli.js --backend pg migrate",
    "migrate:status": "node dist/cli.js migrate --status",
    "migrate:status:file": "node dist/cli.js --backend file migrate --status",
    "migrate:status:pg": "node dist/cli.js --backend pg migrate --status",
    "publish": "node dist/cli.js publish",
    "publish:file": "node dist/cli.js --backend file publish",
    "publish:pg": "node dist/cli.js --backend pg publish"
  },
  "dependencies": {
    "@agent-local/vectorizer": "*",
    "@agent-local/vectorstore": "*",
    "commander": "^12.1.0",
    "ignore": "^5.3.2",
    "pg": "^8.13.1",
    "tree-sitter": "^0.22.4",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
