{
  "name": "@agent-local/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Co-hosted express process: owns the single root Eventing bus and the mount contract every feature workspace mounts into.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./mount": { "types": "./dist/mount.d.ts", "default": "./dist/mount.js" },
    "./events": { "types": "./dist/events.d.ts", "default": "./dist/events.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "db:init": "node dist/db/db-init.js",
    "db:init:dev": "tsx src/db/db-init.ts",
    "test": "jest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agent-local/common": "*",
    "@agent-local/temporal": "*",
    "@agent-local/web": "*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
