{
  "name": "@agent-local/fsmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing workspace-scoped filesystem and search tools (read/write/edit/list/glob/grep).",
  "bin": {
    "fsmcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "fast-glob": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
