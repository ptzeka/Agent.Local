{
  "name": "@agent-local/common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared foundation primitives (cancellation, eventing, DI container, logging) reused across packages.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./lifetime": { "types": "./dist/lifetime.d.ts", "default": "./dist/lifetime.js" },
    "./tokenusage": { "types": "./dist/tokenusage.d.ts", "default": "./dist/tokenusage.js" },
    "./eventing": { "types": "./dist/eventing.d.ts", "default": "./dist/eventing.js" },
    "./container": { "types": "./dist/container.d.ts", "default": "./dist/container.js" },
    "./ilogger": { "types": "./dist/ilogger.d.ts", "default": "./dist/ilogger.js" },
    "./filelogger": { "types": "./dist/filelogger.d.ts", "default": "./dist/filelogger.js" },
    "./appsettings": { "types": "./dist/appsettings.d.ts", "default": "./dist/appsettings.js" },
    "./jwt": { "types": "./dist/jwt.d.ts", "default": "./dist/jwt.js" }
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
