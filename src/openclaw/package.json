{
  "name": "@agent-local/openclaw-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace wrapper that runs openclaw against this repo's local Ollama models and local MCP servers (fsmcp, codemcp).",
  "scripts": {
    "_oc": "cross-env OPENCLAW_CONFIG_PATH=C:/www/Agent.Local/src/openclaw/.openclaw/openclaw.json OPENCLAW_STATE_DIR=C:/www/Agent.Local/src/openclaw/.openclaw openclaw",
    "start": "npm run _oc -- chat",
    "chat": "npm run _oc -- chat",
    "gateway": "npm run _oc -- gateway run",
    "onboard": "npm run _oc -- onboard --non-interactive --accept-risk --mode local --flow quickstart --auth-choice ollama --workspace C:/www/Agent.Local/src/openclaw/.openclaw/workspace --no-install-daemon --skip-bootstrap",
    "configure": "npm run _oc -- configure",
    "update": "npm run _oc -- update",
    "status": "npm run _oc -- status",
    "doctor": "npm run _oc -- doctor",
    "validate": "npm run _oc -- config validate",
    "models:list": "npm run _oc -- models list --plain",
    "mcp:list": "npm run _oc -- mcp list",
    "build": "tsc -p tsconfig.json",
    "postbuild": "npm run sync:context",
    "dev": "tsc -p tsconfig.json --watch",
    "sync:context": "node scripts/sync-context.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cross-env": "^10.1.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "openclaw": "^2026.5.28"
  }
}
