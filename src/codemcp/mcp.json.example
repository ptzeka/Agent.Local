{
  "_comment": "Copy a block into ~/.cursor/mcp.json. Use an ABSOLUTE path to dist/server.js in args. Rebuild tools/codemcp after pulling. With --backend file, you may OMIT --repository: the server scans tools/codeindex/data (or tools/codemcp/data) and registers every repository id found in published commits. Optional explicit --repository pins or adds paths: name-only uses tools/codeindex/data when schema_versions.json exists there; owner/name:/absolute/path for {path}/.codemcp/data/...",

  "mcpServers": {
    "codemcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/absolute/path/to/Rxo.Platform.Web.Sandbox/tools/codemcp/dist/server.js",
        "--backend",
        "file",
        "--branch",
        "main"
      ],
      "cwd": "/absolute/path/to/Rxo.Platform.Web.Sandbox/tools/codemcp"
    },

    "codemcp-file-with-explicit-repo": {
      "_comment": "Optional: pass --repository to pin default order or when not using shared codeindex/data.",
      "type": "stdio",
      "command": "node",
      "args": [
        "/absolute/path/to/Rxo.Platform.Web.Sandbox/tools/codemcp/dist/server.js",
        "--backend",
        "file",
        "--branch",
        "main",
        "--repository",
        "Platform/Rxo.Platform.Web.Sandbox"
      ],
      "cwd": "/absolute/path/to/Rxo.Platform.Web.Sandbox/tools/codemcp"
    },

    "codemcp-file-multi-path": {
      "_comment": "Multi-repo: repeat --repository, or one flag with entries separated by semicolons (not spaces). Mix name-only and name:path as needed.",
      "type": "stdio",
      "command": "node",
      "args": [
        "/absolute/path/to/Rxo.Platform.Web.Sandbox/tools/codemcp/dist/server.js",
        "--backend",
        "file",
        "--branch",
        "main",
        "--repository",
        "Platform/Rxo.Platform.Web.Sandbox;Platform/OtherRepo:/absolute/path/to/OtherRepo"
      ],
      "cwd": "/absolute/path/to/Rxo.Platform.Web.Sandbox/tools/codemcp"
    },

    "codemcp-pg": {
      "_comment": "Postgres backend. Pass --pg-dsn or connectionString in codemcp.config.json next to cwd.",
      "type": "stdio",
      "command": "node",
      "args": [
        "/absolute/path/to/Rxo.Platform.Web.Sandbox/tools/codemcp/dist/server.js",
        "--backend",
        "pg",
        "--branch",
        "main",
        "--pg-dsn",
        "postgres://codeindex_user:CHANGE_ME@localhost:5432/codeindex"
      ],
      "cwd": "/absolute/path/to/Rxo.Platform.Web.Sandbox/tools/codemcp"
    }
  }
}
