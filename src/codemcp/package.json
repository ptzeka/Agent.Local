{
  "name": "@peritze/codemcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model Context Protocol server exposing the codeindex PostgreSQL store to coding assistants.",
  "bin": {
    "codemcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "start": "node dist/server.js",
    "start:file": "node dist/server.js --backend file",
    "start:pg": "node dist/server.js --backend pg",
    "probe": "node dist/server.js probe",
    "tools": "node dist/server.js tools",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agent-local/mcp": "*",
    "@agent-local/vectorizer": "*",
    "@agent-local/vectorstore": "*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^12.1.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
