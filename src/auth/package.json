{
  "name": "@agent-local/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone express IdP: owns the RS256 signing keys, the credential store, and all auth endpoints (/account/*, /connect/token, OIDC discovery + JWKS).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agent-local/common": "*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
