{
  "name": "@agent-local/workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Camunda 8 (Zeebe) workflow integration: deploys BPMN, runs job workers, and publishes job events onto the shared Eventing bus. Camunda always initiates.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --enable-source-maps dist/main.js",
    "test": "jest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agent-local/common": "0.1.0",
    "@camunda8/sdk": "^8.7.20",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
