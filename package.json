{
  "name": "agent-local",
  "version": "0.1.0",
  "description": "Local coding agent powered by Ollama with multi-agent orchestration and MCP tools (npm workspaces root).",
  "type": "module",
  "private": true,
  "workspaces": [
    "src/common",
    "src/mcp",
    "src/fsmcp",
    "src/agent",
    "src/codeindex",
    "src/codemcp",
    "src/codemanagermcp",
    "src/openclaw"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
