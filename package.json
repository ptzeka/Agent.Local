{
  "name": "agent-local",
  "version": "0.1.0",
  "description": "Local coding agent powered by Ollama with multi-agent orchestration and MCP tools",
  "type": "module",
  "private": true,
  "bin": {
    "agent-local": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "tools": "tsx src/tools/server.ts",
    "tools:build": "tsc -p tsconfig.json && node dist/tools/server.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "ollama": "^0.5.11",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
