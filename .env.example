# Ollama daemon URL. Default points at the local install.
OLLAMA_HOST=http://localhost:11434

# Root directory the agent is allowed to read/write within.
# Use an absolute path. All FS tool calls are confined to this directory.
AGENT_WORKSPACE=.

# Google Gemini API key. Required when any model uses provider "gemini".
# GEMINI_API_KEY=your_gemini_api_key_here

# How many tool-call turns the executor may take before the loop aborts.
AGENT_MAX_ITERATIONS=12

# Project direction file. Defaults to src/context/agentcontext.md under the
# workspace root if present. Set to a different path (absolute, or relative
# to AGENT_WORKSPACE) to override.
# AGENT_CONTEXT_FILE=src/context/agentcontext.md
