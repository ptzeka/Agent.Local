{
  "$schema": "https://modelcontextprotocol.io/schema/mcp.json",
  "mcpServers": {
    "codemcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@peritze/codemcp",
        "--backend",
        "file"
      ]
    },
    "memomcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@peritze/memomcp",
        "--backend",
        "file",
        "--embed-provider",
        "local"
      ]
    }
  }
}
