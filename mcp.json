{
  "$schema": "https://modelcontextprotocol.io/schema/mcp.json",
  "mcpServers": {
    "codemcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "c:/www/Agent.Local/src/codemcp/dist/server.js",
        "--backend",
        "file"
      ]
    },
    "memomcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "c:/www/Agent.Local/src/memomcp/dist/server.js",
        "--backend",
        "file",
        "--embed-provider",
        "local"
      ]
    }
  }
}
